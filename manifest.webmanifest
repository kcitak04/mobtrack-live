{
  "name": "DATTRACK Studio",
  "short_name": "DT Studio",
  "description": "DATTRACK music tracker, Studio edition (dark grey look).",
  "id": "/mobtrack-live/",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
